msgid "the god is ... dead\nthe world is ... crumbling\nthe very foundational stones,\nupon which it was build...\nscattered\n\n pick up your bow\n save us!"
msgstr "dieu est ... mort\nle monde... s'effondre\nles fondations sur lesquelles\nil a ete bati... dispersees\n\n prenez votre arc\n sauvez-nous !"

msgid "80,34,it's so far now|i will never get home"
msgstr "80,34,c'est tellement loin...|je ne rentrerai jamais"

msgid "112,80,cold..."
msgstr "112,80,froid..."

msgid "45,88,one rogue?|what can only one do?"
msgstr "45,88,un aventurier ?|que peut faire un seul homme ?"

msgid "36,42,is bingo night|on tuesday?"
msgstr "36,42,la soire bingo|c'est le mardi ?"

msgid "79,24,am i fractured|or is it the world?"
msgstr "79,24,suis-je fracture|ou est-ce le monde ?"

msgid "80,34,maybe i can|buid a brige"
msgstr "80,34,peut-etre puis-je|construire un pont"

msgid "112,80,warm!"
msgstr "112,80,chaud !"

msgid "45,88,hmmm|you did it!"
msgstr "45,88,hmmm|vous avez reussi !"

msgid "36,42,there will be a tuesday"
msgstr "36,42,il y aura un mardi"

msgid "79,24,we will be ok|world will be ok"
msgstr "79,24,nous serons ok|le monde sera ok"

